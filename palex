<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Palex Health - Simulador Intervencionista 3D</title>
    <style>
        :root {
            --palex-dark: #0A2240;
            --palex-blue: #009FE3;
            --palex-accent: #00D2FF;
            --danger: #FF334B;
            --success: #00E676;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
        body {
            background-color: var(--palex-dark);
            color: #FFFFFF;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }
        header {
            height: 55px;
            background: rgba(10, 34, 64, 0.95);
            border-bottom: 2px solid var(--palex-blue);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            z-index: 10;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .logo-box {
            background: #FFF;
            color: var(--palex-dark);
            font-weight: 900;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 16px;
            letter-spacing: -0.5px;
        }
        .vitals {
            display: flex;
            gap: 12px;
            font-size: 13px;
        }
        .vital-badge {
            background: rgba(0, 159, 227, 0.15);
            border: 1px solid var(--palex-blue);
            padding: 4px 8px;
            border-radius: 4px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .vital-val { font-weight: bold; color: var(--palex-accent); }
        
        #game-container {
            flex: 1;
            position: relative;
            background: radial-gradient(circle at center, #112B4C 0%, #050E1A 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        .hud-overlay {
            position: absolute;
            top: 12px;
            left: 12px;
            background: rgba(10, 34, 64, 0.85);
            border: 1px solid var(--palex-blue);
            padding: 10px;
            border-radius: 8px;
            font-size: 12px;
            pointer-events: none;
            max-width: 260px;
        }
        .hud-overlay h3 { color: var(--palex-accent); margin-bottom: 4px; font-size: 14px; }
        
        .mode-selector {
            position: absolute;
            top: 12px;
            right: 12px;
            display: flex;
            gap: 6px;
            z-index: 5;
        }
        .mode-btn {
            background: rgba(10, 34, 64, 0.8);
            border: 1px solid var(--palex-blue);
            color: #fff;
            padding: 6px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
        }
        .mode-btn.active { background: var(--palex-blue); }

        .controls-bar {
            height: 110px;
            background: rgba(10, 34, 64, 0.95);
            border-top: 1px solid rgba(0, 159, 227, 0.3);
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 0 16px;
            z-index: 10;
        }
        .btn-action {
            background: var(--palex-blue);
            color: #fff;
            border: none;
            padding: 14px 24px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(0,159,227,0.4);
        }
        .btn-action:active { transform: scale(0.96); }
        
        .joystick-pad {
            width: 90px;
            height: 90px;
            background: rgba(0, 159, 227, 0.15);
            border: 2px solid var(--palex-blue);
            border-radius: 50%;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .joystick-knob {
            width: 40px;
            height: 40px;
            background: var(--palex-accent);
            border-radius: 50%;
            position: absolute;
            box-shadow: 0 2px 8px rgba(0,0,0,0.5);
            transition: transform 0.1s ease;
        }

        .screen-modal {
            position: absolute;
            inset: 0;
            background: rgba(5, 14, 26, 0.92);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 100;
            padding: 24px;
            text-align: center;
        }
        .screen-modal h1 { color: var(--palex-accent); font-size: 26px; margin-bottom: 12px; }
        .screen-modal p { max-width: 400px; margin-bottom: 20px; font-size: 14px; line-height: 1.5; color: #B0BEC5; }
    </style>
</head>
<body>

    <header>
        <div class="brand">
            <div class="logo-box">PALEX</div>
            <div style="font-size: 12px; line-height: 1.2;">
                <strong style="color:var(--palex-accent)">HEALTH</strong><br>
                <span>Simulador Endovascular</span>
            </div>
        </div>
        <div class="vitals">
            <div class="vital-badge"><span>FC</span><span id="v-hr" class="vital-val">72 bpm</span></div>
            <div class="vital-badge"><span>PA</span><span id="v-bp" class="vital-val">120/80</span></div>
            <div class="vital-badge"><span>SPO2</span><span id="v-ox" class="vital-val">98%</span></div>
        </div>
    </header>

    <div class="mode-selector">
        <button class="mode-btn active" onclick="setMode('3d')">Tórax 3D</button>
        <button class="mode-btn" onclick="setMode('endo')">Endovascular</button>
        <button class="mode-btn" onclick="setMode('xray')">Raio-X</button>
    </div>

    <div id="game-container">
        <div class="hud-overlay">
            <h3 id="hud-title">Fase 1: Impella CP®</h3>
            <p id="hud-desc">Avance o cateter pelo arco aórtico. Evite tocar nas paredes vasculares!</p>
            <div style="margin-top: 6px; font-weight: bold; color: var(--success);" id="hud-status">Progresso: 0%</div>
        </div>
        
        <canvas id="simCanvas"></canvas>

        <div id="startModal" class="screen-modal">
            <h1>Simulador Cirúrgico Palex</h1>
            <p>Teste o seu desempenho com o <strong>Impella CP® SmartAssist</strong> e o sistema <strong>FlowTriever® (Inari)</strong>. Controlo tátil otimizado para desktop e telemóvel.</p>
            <button class="btn-action" onclick="startGame()">INICIAR CIRURGIA</button>
        </div>
    </div>

    <div class="controls-bar">
        <div style="display:flex; flex-direction:column; align-items:center;">
            <span style="font-size:11px; color:var(--palex-accent); margin-bottom:4px;">DIREÇÃO / LÚMEN</span>
            <div class="joystick-pad" id="joyPad">
                <div class="joystick-knob" id="joyKnob"></div>
            </div>
        </div>
        <div style="display:flex; gap:12px;">
            <button class="btn-action" id="btnBackward" style="background:#455A64;">RECUAR</button>
            <button class="btn-action" id="btnForward">AVANÇAR</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('simCanvas');
        const ctx = canvas.getContext('2d');
        let width, height;

        function resize() {
            width = canvas.parentElement.clientWidth;
            height = canvas.parentElement.clientHeight;
            canvas.width = width * window.devicePixelRatio;
            canvas.height = height * window.devicePixelRatio;
            ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
        }
        window.addEventListener('resize', resize);
        resize();

        let gameState = 'START'; // START, PLAYING, CONSOLE, WIN, FAIL
        let currentDevice = 'IMPELLA'; // IMPELLA, FLOWTRIEVER
        let cameraMode = '3d'; // 3d, endo, xray
        let progress = 0; // 0 to 100
        let stability = 100;
        let hits = 0;
        let valveOpen = false;
        let valveTimer = 0;
        
        // Control state
        let movingForward = false;
        let movingBackward = false;
        let steeringOffset = { x: 0, y: 0 };

        function setMode(m) {
            cameraMode = m;
            document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');
        }

        function startGame() {
            document.getElementById('startModal').style.display = 'none';
            gameState = 'PLAYING';
        }

        // Joystick interaction
        const joyPad = document.getElementById('joyPad');
        const joyKnob = document.getElementById('joyKnob');
        let joyActive = false;

        function handleJoyMove(clientX, clientY) {
            const rect = joyPad.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            let dx = clientX - cx;
            let dy = clientY - cy;
            const dist = Math.sqrt(dx*dx + dy*dy);
            const maxR = 30;
            if (dist > maxR) {
                dx = (dx / dist) * maxR;
                dy = (dy / dist) * maxR;
            }
            joyKnob.style.transform = `translate(${dx}px, ${dy}px)`;
            steeringOffset.x = dx / maxR;
            steeringOffset.y = dy / maxR;
        }

        joyPad.addEventListener('pointerdown', e => { joyActive = true; handleJoyMove(e.clientX, e.clientY); });
        window.addEventListener('pointermove', e => { if (joyActive) handleJoyMove(e.clientX, e.clientY); });
        window.addEventListener('pointerup', () => { joyActive = false; joyKnob.style.transform = 'translate(0px, 0px)'; steeringOffset = {x:0, y:0}; });

        document.getElementById('btnForward').addEventListener('pointerdown', () => { movingForward = true; });
        document.getElementById('btnForward').addEventListener('pointerup', () => { movingForward = false; });
        document.getElementById('btnBackward').addEventListener('pointerdown', () => { movingBackward = true; });
        document.getElementById('btnBackward').addEventListener('pointerup', () => { movingBackward = false; });

        // Game Loop
        let lastTime = performance.now();
        function loop(timestamp) {
            const dt = (timestamp - lastTime) / 1000;
            lastTime = timestamp;

            update(dt);
            render();

            requestAnimationFrame(loop);
        }

        function update(dt) {
            if (gameState !== 'PLAYING') return;

            // Valve timing cycle (~45 BPM = 1.33s per cycle)
            valveTimer += dt;
            if (valveTimer > 1.33) valveTimer = 0;
            valveOpen = (valveTimer > 0.3 && valveTimer < 1.0); // Wide open window

            // Movement
            if (progress < 88) {
                if (movingForward) progress += dt * 15;
                if (movingBackward) progress -= dt * 20;
                progress = Math.max(0, Math.min(88, progress));

                // Check wall collision based on steering offset
                if (Math.abs(steeringOffset.x) > 0.7 || Math.abs(steeringOffset.y) > 0.7) {
                    stability -= dt * 15;
                    hits++;
                    if (stability <= 0) {
                        gameState = 'FAIL';
                    }
                }
            } else {
                // Auto lock at target
                gameState = 'CONSOLE';
                showConsoleModal();
            }

            // HUD update
            document.getElementById('hud-status').innerText = `Progresso: ${Math.round(progress)}% | Estabilidade: ${Math.round(stability)}%`;
        }

        function showConsoleModal() {
            if (document.getElementById('consoleModal')) return;
            const modal = document.createElement('div');
            modal.id = 'consoleModal';
            modal.className = 'screen-modal';
            modal.innerHTML = `
                <h1>Consola SmartAssist® Ativa</h1>
                <p>Cateter posicionado com sucesso no Ventrículo Esquerdo. Selecione o nível de suporte P-8 para otimizar o débito cardíaco.</p>
                <div style="display:flex; gap:10px; margin-bottom:20px;">
                    <button class="mode-btn" onclick="setPower('P-4')">P-4</button>
                    <button class="mode-btn" onclick="setPower('P-6')">P-6</button>
                    <button class="mode-btn active" onclick="setPower('P-8')">P-8 (Ideal)</button>
                    <button class="mode-btn" onclick="setPower('P-9')">P-9</button>
                </div>
                <button class="btn-action" onclick="finishImpella()">CONFIRMAR SUPORTE</button>
            `;
            document.getElementById('game-container').appendChild(modal);
        }

        window.setPower = function(p) {
            document.querySelectorAll('#consoleModal .mode-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');
        };

        window.finishImpella = function() {
            document.getElementById('consoleModal').remove();
            currentDevice = 'FLOWTRIEVER';
            progress = 0;
            stability = 100;
            document.getElementById('hud-title').innerText = 'Fase 2: FlowTriever® (Inari)';
            document.getElementById('hud-desc').innerText = 'Avance para a artéria pulmonar e expanda os discos de nitinol.';
            gameState = 'PLAYING';
        };

        function render() {
            ctx.clearRect(0, 0, width, height);

            // Background grid / X-Ray / 3D Torso simulation
            if (cameraMode === 'xray') {
                ctx.fillStyle = '#050E1A';
                ctx.fillRect(0, 0, width, height);
                ctx.strokeStyle = 'rgba(0, 210, 255, 0.15)';
            } else if (cameraMode === 'endo') {
                ctx.fillStyle = '#1A0505';
                ctx.fillRect(0, 0, width, height);
                ctx.strokeStyle = 'rgba(255, 51, 75, 0.2)';
            } else {
                ctx.fillStyle = '#081628';
                ctx.fillRect(0, 0, width, height);
                ctx.strokeStyle = 'rgba(0, 159, 227, 0.2)';
            }

            // Draw grid lines
            ctx.lineWidth = 1;
            for (let x = 0; x < width; x += 40) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
            }
            for (let y = 0; y < height; y += 40) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
            }

            // Draw Heart & Aorta S-Curve
            const cx = width / 2;
            const cy = height / 2;

            ctx.beginPath();
            ctx.strokeStyle = cameraMode === 'xray' ? '#00D2FF' : '#009FE3';
            ctx.lineWidth = 24;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.moveTo(cx - 100, cy + 120);
            ctx.bezierCurveTo(cx - 100, cy - 40, cx + 80, cy - 80, cx + 60, cy + 40);
            ctx.stroke();

            // Draw Valve Indicator
            ctx.beginPath();
            ctx.arc(cx + 20, cy - 20, 28, 0, Math.PI * 2);
            ctx.fillStyle = valveOpen ? 'rgba(0, 230, 118, 0.25)' : 'rgba(255, 51, 75, 0.25)';
            ctx.fill();
            ctx.strokeStyle = valveOpen ? 'var(--success)' : 'var(--danger)';
            ctx.lineWidth = 3;
            ctx.stroke();

            // Draw Cateter / Dispositivo
            const catheterLengthFactor = progress / 88;
            ctx.beginPath();
            ctx.strokeStyle = '#FFFFFF';
            ctx.lineWidth = 4;
            ctx.moveTo(cx - 100, cy + 120 + steeringOffset.y * 15);
            ctx.lineTo(cx + (catheterLengthFactor * 120) + steeringOffset.x * 15, cy + (catheterLengthFactor * -40));
            ctx.stroke();

            // Tip indicator
            ctx.beginPath();
            ctx.arc(cx + (catheterLengthFactor * 120) + steeringOffset.x * 15, cy + (catheterLengthFactor * -40), 8, 0, Math.PI*2);
            ctx.fillStyle = currentDevice === 'IMPELLA' ? 'var(--palex-accent)' : '#FFD700';
            ctx.fill();
        }

        requestAnimationFrame(loop);
    </script>
</body>
</html>
